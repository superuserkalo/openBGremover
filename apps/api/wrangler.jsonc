{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbg-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://openbgremover.dev,https://www.openbgremover.dev",
    "SUPABASE_URL": "https://bxwzgybcivctgasyhwur.supabase.co",
    "BEAM_ENDPOINT_URL": "https://app.beam.cloud/endpoint/bg-removal/v18",
    "IMAGE_PROCESSING_ENDPOINT_URL": "https://image-processing-e41046c-v1.app.beam.cloud",
    "BEAM_OUTPUT_URL_PREFIX": "https://s3.wasabisys.com/workspace-prod-0cec183f-7477-43a6-879a-a2362c671dd1/"
  },
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "8bf0fba337c646be9c1523ecc201f1bb",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  "ratelimits": [
    {
      "name": "TRIAL_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SECRET_KEY",
      "BEAM_API_KEY"
    ]
  },
  "account_id": "ead8e94d4354734f3ac631e4ab2472ae",
  "workers_dev": true,
  "preview_urls": false
}
